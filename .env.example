# ============================================================
#  Cozinha da Dudu — variáveis de ambiente
#  Copie este arquivo para ".env" e preencha os valores.
# ============================================================

# --- Supabase ---
# Pegue em: Supabase > Project Settings > API
#   VITE_SUPABASE_URL      = "Project URL"   (ex: https://xxxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = "anon public"   (chave pública/anon)
# Se DEIXAR EM BRANCO, o app roda em modo LOCAL (mock + localStorage), sem nuvem.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL pública usada para gerar os links de cardápio
# Em produção (Cloudflare) use o domínio real, ex: https://cozinhadadudu.pages.dev
VITE_PUBLIC_BASE_URL=http://localhost:5173
